GEMINI_API_KEY=
FRED_API_KEY=
NASDAQ_API_KEY=
SCRAPER_API_KEY=
RESEND_API_KEY=
SUPABASE_URL=
# anon / publishable — той самий, що в src/lib/supabase.js. НЕ service_role.
SUPABASE_KEY=
TG_BOT_TOKEN=

# Підтвердження пошти (api/verify-email.js).
# service_role обходить RLS — тільки для сервера, у браузер не потрапляє.
SUPABASE_SERVICE_ROLE_KEY=
# Куди повертати юзера після кліку в листі. На проді — домен сайту.
SITE_URL=http://localhost:5173

# Публічний ключ, яким браузер шифрує пароль інвестора перед
# відправкою в базу (src/lib/mt5Store.js). SPKI у base64, один рядок.
# Це НЕ секрет: він потрапляє в бандл і так задумано. Приватна
# половина пари живе тільки на VPS і сюди не пишеться ніколи.
VITE_MT5_PUBLIC_KEY=
# Піднімати на +1 при кожній зміні пари ключів — інакше потім не
# розібрати, який рядок яким ключем зашифрований.
VITE_MT5_KEY_VERSION=1
