# Що не потрапляє в контекст збірки.
#
# node_modules тут головний: він важить сотні мегабайтів і його все
# одно перевстановлює `npm ci` всередині образу. Гірше — у ньому
# лежать нативні бінарники rolldown під ту систему, де його ставили
# (у нас Windows), і в linux-образі вони просто не запустяться.
node_modules
dist

.git
.gitignore

# Ключі. Змінні оточення на сервері задає Coolify, і всередині образу
# їм робити нічого: образ можна викласти, передати, залишити в реєстрі
# — а секрет у ньому лишиться назавжди.
.env
.env.*

.vscode
.idea
*.log
npm-debug.log*

# Службове — до збірки стосунку не має.
.claude
CLAUDE.md
netlify.toml
vercel.json
